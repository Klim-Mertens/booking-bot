# Скопируйте в .env и заполните. Файл .env НИКОГДА не коммитится.
TG_TOKEN=
MAX_TOKEN=
# Ключ шифрования телефонов: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENC_KEY=
# Ключ для поиска по телефону: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PII_HMAC_KEY=
# Числовые ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=
# ID администраторов в MAX
MAX_ADMIN_IDS=
CONFIG_PATH=config.toml
DB_PATH=bookings.db
